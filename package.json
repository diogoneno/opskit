{
  "name": "opskit",
  "version": "0.1.1",
  "private": true,
  "description": "Keyboard-first DevOps/SRE toolbox that runs entirely in your browser: JSON/YAML/JMESPath, CIDR, cron, JWT, hashes, Kubernetes Secret, docker run → Compose, SLO error budget and more. Nothing leaves the tab; works offline.",
  "homepage": "https://diogoneno.github.io/opskit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diogoneno/opskit.git"
  },
  "bugs": {
    "url": "https://github.com/diogoneno/opskit/issues"
  },
  "author": "Diogo Neno",
  "keywords": [
    "devops",
    "sre",
    "developer-tools",
    "toolbox",
    "client-side",
    "offline",
    "pwa",
    "privacy",
    "json",
    "yaml",
    "jmespath",
    "cidr",
    "cron",
    "jwt",
    "sha256",
    "kubernetes",
    "docker-compose",
    "slo",
    "error-budget",
    "osv",
    "react",
    "vite",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "readme:tools": "node scripts/readme-tools.mjs",
    "deploy": "npm run build && gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "jmespath": "^0.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/jmespath": "^0.15.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  }
}
